# Copy to .env (gitignored) or export these in the shell that runs the chain.

# Mailbox verification (usebouncer.com). Optional: without it, verification is skipped and
# addresses go out unverified.
BOUNCER_API_KEY=

# Where the Gmail OAuth client_secret.json and token.json live. Optional: defaults to
# ~/.config/outreach-engine/. Keep this OUTSIDE the repo.
OUTREACH_GMAIL_DIR=

# Sent on every outbound API call to GitHub, Reddit, HN, Bluesky and Mastodon. Set it to
# something that identifies you and gives them a way to reach you - it is the polite thing
# and several of those APIs ask for it.
USER_AGENT=signal-research/0.4

# Optional. Points a helper at a second checkout when you run this from a worktree.
MAIN_CHECKOUT=

# The engine's own local timezone, used to anchor the daily schedule.
LOCAL_TZ=America/New_York
